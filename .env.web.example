# Real HTTPS endpoints must replace these reserved .invalid examples for live SSO.
# For credential-free validation use scripts/smoke_web.py instead.
WEB_ORIGIN=https://calendar.example.invalid
KEYCLOAK_ISSUER=https://login.example.invalid/realms/calendar-sync
KEYCLOAK_CLIENT_ID=calendar-sync
KEYCLOAK_CLIENT_SECRET_FILE=/run/web-secrets/client-secret
WEB_CONTROL_FILE=/data/web/control/control.sqlite3
WEB_CONTROL_KEY_FILE=/run/web-secrets/control.key
WEB_SESSION_FILE=/data/web/sessions/sessions.sqlite3
WEB_SESSION_KEY_FILE=/run/web-secrets/session.key
