# Copy to examples/uat/.env, then replace every REPLACE value.
# Settings and absolute paths only: never put token/password contents here.
UAT_GOOGLE_TOKEN_SOURCE=/REPLACE/absolute/private/google-uat-token.json
UAT_NEXTCLOUD_PASSWORD_SOURCE=/REPLACE/absolute/private/nextcloud-password
GOOGLE_CALENDAR_ID=REPLACE_WITH_EXACT_GOOGLE_TEST_CALENDAR_ID
NEXTCLOUD_CALENDAR_URL=http://localhost:8090/remote.php/dav/calendars/REPLACE_USER/REPLACE_EMPTY_CALENDAR_URI/
NEXTCLOUD_USERNAME=REPLACE_USER
SYNC_DRY_RUN=true
