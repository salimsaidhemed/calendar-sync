# Safe default: reads calendars but never writes destination events.
SYNC_DRY_RUN=true
SYNC_CONFIGURATION_ID=master
SYNC_POLL_SECONDS=300
SYNC_MAX_BACKOFF_SECONDS=3600
SYNC_HEALTH_MAX_AGE_SECONDS=7200
SYNC_STATE_FILE=/data/calendar-sync.sqlite3
SYNC_HEALTH_FILE=/data/health.json
# Stable exact ID, never the primary alias. No credentials belong in this file.
GOOGLE_CALENDAR_ID=replace-with-exact-calendar-id
GOOGLE_TOKEN_FILE=/run/secrets/google/token.json
NEXTCLOUD_URL=https://nextcloud.tcadc.com
NEXTCLOUD_CALENDAR_URL=https://nextcloud.tcadc.com/remote.php/dav/calendars/REPLACE_USER/REPLACE_CALENDAR/
NEXTCLOUD_USERNAME=REPLACE_USER
NEXTCLOUD_PASSWORD_FILE=/run/secrets/nextcloud/password
# HTTP only for explicitly matching loopback URLs in local Python tests.
# Container localhost refers to the container, not the host PC.
NEXTCLOUD_ALLOW_HTTP_LOOPBACK=false
