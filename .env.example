SYNC_DRY_RUN=true
NEXTCLOUD_URL=https://nextcloud.tcadc.com
# The CalDAV library/UAT scripts require an explicit calendar URL, login username
# and an app-password file. They are not wired into CLI environment settings yet.
# Follow docs/nextcloud.md; never put an app password in this file.
# Google authorization currently uses explicit CLI file arguments; the read
# adapter uses an explicit calendar ID. These are not loaded from this file yet.
# See docs/google.md. Never paste secrets here; use ignored files under secrets/.
